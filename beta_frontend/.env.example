# Base path the browser uses for API calls. Keep "/api/v1" in dev so requests go through the Vite proxy.
VITE_API_BASE_URL=/api/v1

# Where the Vite dev server forwards /api requests (the FastAPI backend).
VITE_API_PROXY_TARGET=http://localhost:8000

# In-browser mock server for endpoints the backend doesn't have yet (see src/mocks/README.md).
#   users = mock /users/* only, real auth (default in dev)
#   all   = mock everything, no backend needed
#   off   = real backend only (default in production builds)
VITE_MOCK_API=users

# Make the mock server withhold spoiler text past your reading progress, the way the real
# backend eventually will. With "false" the browser does the hiding on its own.
VITE_MOCK_REDACT_SPOILERS=false
